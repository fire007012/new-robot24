<launch>
  <arg name="config_file" default="$(find flipper_control)/config/flipper_control.yaml"/>
  <arg name="backend_type" default="hybrid"/>
  <arg name="hybrid_ns" default="/hybrid_motor_hw_node"/>
  <arg name="canopen_ns" default="/canopen_hw_node"/>
  <arg name="canopen_diagnostics_topic" default="/diagnostics"/>
  <arg name="require_backend_feedback" default="true"/>
  <arg name="initial_profile" default="csv_velocity"/>
  <arg name="csv_command_interface" default="multi_array"/>
  <arg name="csv_controller" default=""/>

  <rosparam file="$(arg config_file)" command="load" ns="flipper_control"/>
  <param name="flipper_control/backend_type" value="$(arg backend_type)"/>
  <param name="flipper_control/hybrid_ns" value="$(arg hybrid_ns)"/>
  <param name="flipper_control/canopen_ns" value="$(arg canopen_ns)"/>
  <param name="flipper_control/canopen_diagnostics_topic" value="$(arg canopen_diagnostics_topic)"/>
  <param name="flipper_control/require_backend_feedback" value="$(arg require_backend_feedback)"/>
  <param name="flipper_control/initial_profile" value="$(arg initial_profile)"/>
  <param name="flipper_control/csv_command_interface" value="$(arg csv_command_interface)"/>
  <param name="flipper_control/controllers/csv" value="$(arg csv_controller)"
         if="$(eval arg('csv_controller') != '')"/>

  <node name="flipper_control"
        pkg="flipper_control"
        type="flipper_manager_node"
        output="screen"/>
</launch>
