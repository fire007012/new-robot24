<launch>
  <!-- =========================================================
       can_driver 启动文件
       启动顺序：加载参数 → 启动节点 → 加载控制器
       ========================================================= -->

  <!-- 是否加载 ros_control 控制器（默认 false：直通调试模式） -->
  <arg name="use_controllers" default="false"/>
  <arg name="config_file" default="$(find can_driver)/config/can_driver.yaml"/>
  <arg name="controllers_file" default="$(find can_driver)/config/ros_controllers.yaml"/>
  <arg name="start_controllers" default="joint_state_controller arm_controller wheel_controller"/>
  <arg name="pp_local_zero_offset_file" default="$(find can_driver)/config/can_driver_pp_zero_offsets.txt"/>

  <!-- ECB SDK 依赖该路径定位 logtool；对非 ECB 协议无副作用。 -->
  <env name="ACTUATOR_TOOL_PATH" value="$(find can_driver)/lib/innfos-cpp-sdk/tools/logtool/linux_x86_64"/>

  <!-- 1. 加载硬件参数（关节映射、控制频率） -->
  <rosparam file="$(arg config_file)" command="load"/>
  <param name="can_driver_node/pp_local_zero_offset_file"
         value="$(arg pp_local_zero_offset_file)"/>

  <!-- 2. 加载控制器参数（仅在 use_controllers=true 时加载） -->
  <rosparam file="$(arg controllers_file)" command="load"
            if="$(eval arg('use_controllers') and arg('controllers_file') != '')"/>

  <!-- 3. 启动 can_driver_node（包含 CanDriverHW + controller_manager 主循环） -->
  <node pkg="can_driver" type="can_driver_node" name="can_driver_node" output="screen"/>

  <!-- 4. 加载并启动控制器（仅在 use_controllers=true 时启动） -->
  <node pkg="controller_manager" type="spawner" name="controller_spawner"
        args="$(arg start_controllers)"
        if="$(eval arg('use_controllers') and arg('start_controllers') != '')"/>

</launch>
