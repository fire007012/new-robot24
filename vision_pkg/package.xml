<?xml version="1.0"?>
<package format="3">
<name>vision_pkg</name><version>0.3.0</version>
<description>ROS2 vision processing, depth geometry, panorama and H265 nodes</description>
<maintainer email="dianhua@example.com">dianhua</maintainer><license>MIT</license>
<buildtool_depend>ament_cmake</buildtool_depend>
<exec_depend>launch_ros</exec_depend>
<exec_depend>ament_index_python</exec_depend>
<exec_depend>python3-opencv</exec_depend>
<exec_depend>python3-numpy</exec_depend>
<depend>rclcpp</depend>
<depend>sensor_msgs</depend>
<depend>std_msgs</depend>
<depend>geometry_msgs</depend>
<depend>cv_bridge</depend>
<depend>image_transport</depend>
<buildtool_depend>rosidl_default_generators</buildtool_depend>
