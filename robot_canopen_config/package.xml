  <version>0.1.0</version>
  <description>Reproducible CANopen bus configuration for the six robot axes.</description>
  <maintainer email="dianhua@example.com">dianhua</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>python3-yaml</build_depend>
  <exec_depend>canopen_master_driver</exec_depend>
  <exec_depend>canopen_402_driver</exec_depend>
