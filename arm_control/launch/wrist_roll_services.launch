<launch>
  <arg name="startup_delay" default="3.0" />

  <rosparam command="load" file="$(find arm_control)/config/wrist_roll_services.yaml" />

  <node pkg="arm_control"
        type="wrist_roll_service_node.py"
        name="wrist_roll_service_node"
        launch-prefix="bash -c 'sleep $(arg startup_delay); exec $0 $@'"
        output="screen" />
</launch>
