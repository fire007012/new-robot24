#!/usr/bin/env python3
"""Explicit group operations through the single runtime coordinator."""
import argparse
import json
import rclpy
from rclpy.node import Node
from robot_hardware.srv import GroupOperation
from std_srvs.srv import Trigger

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('operation',choices=['init','enable','resume','halt','recover','shutdown','recover_resource','global_stop','reset_global_stop'])
    parser.add_argument('groups',nargs='*',choices=None)
    parser.add_argument('--all',action='store_true',help='explicitly select all four groups')
    parser.add_argument('--resource',choices=['RobotCanopenSystem','CanDriverSystem'])
    args=parser.parse_args()
    if args.all and args.groups:parser.error('select explicit groups or --all')
    groups=['arm','flippers','base','gripper'] if args.all else args.groups
    global_operation=args.operation in ('global_stop','reset_global_stop')
    if args.resource and args.operation!='recover_resource':parser.error('--resource is only valid for recover_resource')
    if args.operation=='recover_resource':
        if not args.resource or groups:parser.error('resource recovery requires --resource and no group selection')
    elif not global_operation and (not groups or not set(groups)<=set(['arm','flippers','base','gripper'])):
        parser.error('select known groups explicitly or use --all')
    if global_operation and (groups or args.resource):parser.error('global operation takes no group/resource selection')
    rclpy.init();node=Node('robot_group_command')
    try:
        kind=Trigger if global_operation else GroupOperation
        path='/robot_runtime/'+args.operation if global_operation else '/robot_runtime/group_operation'
        client=node.create_client(kind,path)
        if not client.wait_for_service(timeout_sec=5):raise RuntimeError(path+': unavailable')
        request=Trigger.Request() if global_operation else GroupOperation.Request(groups=groups,operation=args.operation,resource=args.resource or '')
        future=client.call_async(request);rclpy.spin_until_future_complete(node,future,timeout_sec=300)
        if not future.done():raise RuntimeError('remote outcome unknown; inspect /robot_runtime/state before retrying')
        result=future.result()
        print(json.dumps({'success':result.success,'operation_id':getattr(result,'operation_id',''),'message':result.message},ensure_ascii=False))
        return 0 if result.success else 1
    finally:
        node.destroy_node();rclpy.shutdown()
if __name__=='__main__':raise SystemExit(main())
