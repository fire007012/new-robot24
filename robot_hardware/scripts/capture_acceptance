#!/usr/bin/env python3
"""Passive CAN and ROS evidence recorder; never sends CAN frames."""
import argparse
import json
import math
from pathlib import Path
import select
import time

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState
from std_msgs.msg import String
from std_srvs.srv import Trigger

from robot_hardware_runtime.capture import CanStatistics, open_channel, receive_batch


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--interfaces', nargs='*', default=['canable0', 'canable1'])
    parser.add_argument('--seconds', type=float, default=60)
    parser.add_argument('--bitrate', type=int, default=1000000)
    parser.add_argument('--output', required=True)
    args = parser.parse_args()
    if not math.isfinite(args.seconds) or args.seconds <= 0 or args.bitrate <= 0:
        parser.error('seconds and bitrate must be positive and finite')
    if len(set(args.interfaces)) != len(args.interfaces):
        parser.error('interfaces must be unique')
    root = Path(args.output)
    root.mkdir(parents=True, exist_ok=False)
    rclpy.init()
    node = Node('canopen_acceptance_capture')
    records, runtime, periods, status_errors = [], [], [], []
    finite = lambda values: [v if math.isfinite(v) else None for v in values]
    node.create_subscription(JointState, '/joint_states', lambda m: records.append({
        't': time.monotonic(), 'name': list(m.name), 'position': finite(m.position),
        'velocity': finite(m.velocity),
        'feedback_valid': [i < len(m.position) and i < len(m.velocity) and
                           math.isfinite(m.position[i]) and math.isfinite(m.velocity[i])
                           for i in range(len(m.name))]}), 10)
    node.create_subscription(String, '/robot_runtime/state', lambda m: runtime.append({
        't': time.monotonic(), 'state': m.data}), 10)
    client = node.create_client(Trigger, '/robot_runtime/status')
    pending, last_call = None, 0
    channels = {}
    statistics = CanStatistics(args.interfaces)
    try:
        for interface in args.interfaces:
            channels[open_channel(interface)] = interface
        start = time.monotonic()
        start_wall_ns = time.time_ns()
        with (root / 'can_frames.jsonl').open('w') as frames:
            while time.monotonic() - start < args.seconds:
                rclpy.spin_once(node, timeout_sec=.005)
                now = time.monotonic()
                if now - last_call > 1 and pending is None and client.service_is_ready():
                    pending = client.call_async(Trigger.Request())
                    last_call = now
                if pending is not None and pending.done():
                    try:
                        response = pending.result()
                        if not response.success:
                            raise ValueError(response.message)
                        periods.append({'t': now, 'status': json.loads(response.message)})
                    except Exception as error:
                        status_errors.append({'t': now, 'error': str(error)})
                    pending = None
                for channel in select.select(list(channels), [], [], 0)[0]:
                    for record in receive_batch(channel, channels[channel]):
                        statistics.add(record)
                        frames.write(json.dumps(record) + '\n')
        duration = time.monotonic() - start
        report = {'duration_s': duration, 'bitrate': args.bitrate,
                  'start_monotonic_s': start, 'start_wall_time_ns': start_wall_ns,
                  'end_wall_time_ns': time.time_ns(),
                  'control_period_samples': periods, 'status_errors': status_errors,
                  'status_request_pending': pending is not None,
                  'joint_states': records, 'runtime': runtime,
                  **statistics.report(duration, args.bitrate)}
        (root / 'capture.json').write_text(json.dumps(report, indent=2, allow_nan=False) + '\n')
    finally:
        for channel in channels:
            channel.close()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
